{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "title": "SolarBI - Monitoreo inversor 5 kWp",
  "uid": "solarbi-monitoreo",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "",
  "time": {
    "from": "2026-10-05T00:00:00.000Z",
    "to": "2026-10-08T00:00:00.000Z"
  },
  "tags": [
    "solarbi"
  ],
  "templating": {
    "list": [
      {
        "name": "dispositivo",
        "label": "Dispositivo",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_POSTGRES}"
        },
        "query": "SELECT DISTINCT dispositivo_id FROM silver.lectura_5min ORDER BY 1",
        "definition": "SELECT DISTINCT dispositivo_id FROM silver.lectura_5min ORDER BY 1",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Irradiancia y potencia (cada 5 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 11,
        "w": 18,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(ts, '5m'),\n  AVG(irradiancia_wm2) AS \"Irradiancia (W/m²)\",\n  AVG(p_ac_kw) AS \"Potencia (kW)\"\nFROM silver.lectura_5min\nWHERE $__timeFilter(ts)\n  AND dispositivo_id IN ($dispositivo)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Irradiancia (W/m²)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: W/m²"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Potencia (kW)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: kW"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "% de datos válidos",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 11,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  AVG(pct_datos_validos) AS \"% datos válidos\"\nFROM dwh.fact_energia_dia\nWHERE fecha >= $__timeFrom()::date\n  AND fecha <= $__timeTo()::date\n  AND dispositivo IN ($dispositivo)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}